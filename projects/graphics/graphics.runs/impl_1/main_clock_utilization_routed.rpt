# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y17 [get_cells clk_wiz_0_inst/inst/clkout2_buf]
set_property LOC BUFGCTRL_X0Y16 [get_cells clk_wiz_0_inst/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y18 [get_cells clk_wiz_0_inst/inst/clkf_buf]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y76 [get_ports sys_clk]

# Clock net "clk_wiz_0_inst/inst/serial_clk" driven by instance "clk_wiz_0_inst/inst/clkout2_buf" located at site "BUFGCTRL_X0Y17"
#startgroup
create_pblock {CLKAG_clk_wiz_0_inst/inst/serial_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_wiz_0_inst/inst/serial_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_wiz_0_inst/inst/serial_clk"}]]]
resize_pblock [get_pblocks {CLKAG_clk_wiz_0_inst/inst/serial_clk}] -add {CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "clk_wiz_0_inst/inst/pixel_clk" driven by instance "clk_wiz_0_inst/inst/clkout1_buf" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_clk_wiz_0_inst/inst/pixel_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_wiz_0_inst/inst/pixel_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_wiz_0_inst/inst/pixel_clk"}]]]
resize_pblock [get_pblocks {CLKAG_clk_wiz_0_inst/inst/pixel_clk}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup
